{
  "manifest_version": 3,
  "name": "🧰 KengAmp ผู้ช่วยร้าน",
  "version": "0.11.0",
  "description": "ผู้ช่วยร้าน KengAmp: รับ-ส่งแชท Shopee / Lazada เข้า Chat Hub และเปิดหน้าที่ POS ต้องใช้ให้เองตามรอบ",
  "permissions": [
    "alarms",
    "storage",
    "scripting",
    "tabs",
    "notifications",
    "tabGroups"
  ],
  "host_permissions": [
    "https://sellercenter.lazada.co.th/*",
    "https://seller.shopee.co.th/*",
    "https://chat.line.biz/*",
    "https://script.google.com/*",
    "https://script.googleusercontent.com/*",
    "https://kengamp2555.github.io/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "🧰 KengAmp ผู้ช่วยร้าน",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "options_page": "options.html",
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.googleusercontent.com/*"
      ],
      "js": [
        "hubpoke.js"
      ],
      "all_frames": true,
      "run_at": "document_start"
    }
  ]
}
